# Grist on Railway — environment variables
#
# Copy to .env when running locally. On Railway these are set on the
# service; GRIST_SESSION_SECRET and GRIST_BOOT_KEY are deploy-form
# fields and are generated for you, and GRIST_DEFAULT_EMAIL is the one
# field you fill in yourself.

# Long random string that signs login sessions. Grist will not start
# without one. Generated on the deploy form — never change it after
# first boot or everyone gets signed out.
GRIST_SESSION_SECRET=your-generated-session-secret

# Admin boot key. Paste it at /boot on first run to sign in as the
# install admin and complete Quick setup. Generated on the deploy form.
GRIST_BOOT_KEY=your-generated-boot-key

# Email that claims the admin account on first login. Replace with your
# own email to sign in with getgrist.com. Upstream default when unset
# is you@example.com.
GRIST_DEFAULT_EMAIL=you@example.com

# Public base URL for links, forms and embeds. The wrapper derives this
# from the live Railway public domain on every boot; set it manually
# only for a custom domain.
APP_HOME_URL=https://your-grist-domain.up.railway.app

# Formula sandboxing: gvisor (default) runs formulas in a gVisor
# sandbox; pyodide runs them in WebAssembly instead. Set to pyodide if
# the gVisor check fails at boot on your host.
GRIST_SANDBOX_FLAVOR=gvisor

# Pin the client to a single org ("domain"). Unset by default; the
# Quick setup wizard creates the first org for you.
GRIST_SINGLE_ORG=

# Set to true to require sign-in for all access. Only set this once a
# sign-in method (getgrist.com, forwarded headers, OIDC) is configured,
# otherwise nobody can log in except via the boot key.
GRIST_FORCE_LOGIN=false
